# Copy to .env next to docker-compose.yml. The password of the bundled PostgreSQL; both services read it.
# Letters, digits and -_.~ only (it is placed unencoded into MTR_TRACKER_DATABASE_URL); write a $ as $$.
# The server takes it only when its volume is first created. To change it later:
#   docker compose exec db psql -U mtr -d mtr_tracker -c "ALTER USER mtr PASSWORD '<new>'" && docker compose restart mtr-tracker
MTR_TRACKER_DB_PASSWORD=mtr

# The host loopback port the bundled PostgreSQL is published on; the app (host networking) connects there.
# Change it when another server already listens on 5432.
# MTR_TRACKER_DB_PORT=5432
